# Crohniq Dock – Fastlane
#
# project.yml (XcodeGen) ist die Quelle der Wahrheit für Build-Einstellungen.
# Jede Lane, die baut, erzeugt das Xcode-Projekt vorher neu.
#
#   fastlane mac generate   Xcode-Projekt aus project.yml erzeugen
#   fastlane mac build      Debug-Build als Compile-Check
#   fastlane mac archive    Release-App nach build/release bauen
#   fastlane mac bump       Build-Nummer in project.yml um 1 erhöhen
#   fastlane mac install    build/release-App nach /Applications kopieren und neu starten
#   fastlane mac release    bump + archive + install (Optionen: bump:false install:false)
#
# Direktvertrieb – volle Ausgabe mit WhatsApp, Signal, Safari- und Firefox-Verlauf (FULL_EDITION),
# Developer ID, notarisiert, als DMG auf GitHub Releases:
#   fastlane mac developer_id   Release mit Developer-ID-Signatur nach build/developer-id exportieren (Option: full:false)
#   fastlane mac notarize_app   App notarisieren und Ticket anheften
#   fastlane mac dmg            Notarisiertes DMG nach build/dist bauen
#   fastlane mac github_release DMG als GitHub-Release veröffentlichen
#   fastlane mac distribute     bump + developer_id + notarize_app + dmg (Optionen: bump:false publish:true)
# Download-Link, der immer auf die neueste Version zeigt:
#   https://github.com/qx2c4kh2v4-spec/Crohniq_Dock_GifAway/releases/latest/download/Crohniq-Dock.dmg
#
# App Store Connect:
#   fastlane mac upload_metadata  Texte (fastlane/metadata) und Screenshots (fastlane/screenshots) hochladen
#
# Notarisiert wird mit dem App-Store-Connect-API-Schlüssel (siehe asc_key_file). Alternativ ein Schlüsselbund-Profil:
#   NOTARY_PROFILE=<name> fastlane mac distribute

default_platform(:mac)

ROOT        = File.expand_path("..", __dir__)
PROJECT_YML = File.join(ROOT, "project.yml")
PROJECT     = File.join(ROOT, "CrohniqDock.xcodeproj")
SCHEME      = "CrohniqDock"
APP_NAME    = "Crohniq Dock"
OUTPUT_DIR  = File.join(ROOT, "build", "release")
DERIVED     = File.join(ROOT, "build", "DerivedData")
TEAM_ID     = "FW84ZL64CN"
DEVID_DIR   = File.join(ROOT, "build", "developer-id")
DIST_DIR    = File.join(ROOT, "build", "dist")
GITHUB_REPO = "qx2c4kh2v4-spec/Crohniq_Dock_GifAway"
DMG_LATEST  = File.join(DIST_DIR, "Crohniq-Dock.dmg")

# App Store Connect API-Schlüssel: liegt ausserhalb des Repos in ../Fastlane_keys/AuthKey_<KEY_ID>.p8
# (anderer Ort: ASC_KEY_PATH, andere Issuer-ID: ASC_ISSUER_ID).
def asc_key_file
  path = ENV["ASC_KEY_PATH"] || Dir[File.expand_path("../Fastlane_keys/AuthKey_*.p8", ROOT)].first
  UI.user_error!("Kein App-Store-Connect-Schlüssel gefunden (../Fastlane_keys/AuthKey_*.p8 oder ASC_KEY_PATH)") unless path && File.exist?(path)
  { key_id: File.basename(path, ".p8").sub("AuthKey_", ""), key_filepath: path,
    issuer_id: ENV.fetch("ASC_ISSUER_ID", "69a6de8d-03e3-47e3-e053-5b8c7c11a4d1") }
end

def asc_api_key
  app_store_connect_api_key(**asc_key_file)
end

def developer_id_identity
  out = `security find-identity -v -p codesigning`
  out[/"(Developer ID Application: [^"]+\(#{TEAM_ID}\))"/, 1]
end

def notarize_and_staple(path)
  UI.message("Notarisiere #{File.basename(path)} – das dauert meist ein paar Minuten …")
  credentials =
    if ENV["NOTARY_PROFILE"]
      ["--keychain-profile", ENV["NOTARY_PROFILE"]]
    else
      key = asc_key_file
      ["--key", key[:key_filepath], "--key-id", key[:key_id], "--issuer", key[:issuer_id]]
    end
  out = sh("xcrun", "notarytool", "submit", path, *credentials, "--wait")
  UI.user_error!("Notarisierung abgelehnt – Details: xcrun notarytool log <ID> …") unless out.include?("status: Accepted")
end

def build_number
  File.read(PROJECT_YML)[/CURRENT_PROJECT_VERSION:\s*"?(\d+)"?/, 1].to_i
end

def marketing_version
  File.read(PROJECT_YML)[/MARKETING_VERSION:\s*"?([\d.]+)"?/, 1]
end

platform :mac do
  desc "Xcode-Projekt aus project.yml erzeugen"
  lane :generate do
    Dir.chdir(ROOT) { sh("xcodegen", "generate", "--spec", PROJECT_YML) }
  end

  desc "Debug-Build als Compile-Check"
  lane :build do
    generate
    xcodebuild(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      destination: "platform=macOS",
      derivedDataPath: DERIVED,
      build: true
    )
  end

  desc "Build-Nummer in project.yml um 1 erhöhen"
  lane :bump do
    new_number = build_number + 1
    yml = File.read(PROJECT_YML)
    File.write(PROJECT_YML, yml.sub(/(CURRENT_PROJECT_VERSION:\s*)"?\d+"?/, "\\1\"#{new_number}\""))
    UI.success("Build-Nummer: #{new_number}")
    new_number
  end

  desc "Release-App nach build/release bauen"
  lane :archive do
    generate
    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "mac-application",
      output_directory: OUTPUT_DIR,
      output_name: APP_NAME,
      derived_data_path: DERIVED,
      archive_path: File.join(ROOT, "build", "#{SCHEME}.xcarchive"),
      skip_package_pkg: true,
      clean: true
    )
    UI.success("#{APP_NAME} #{marketing_version} (#{build_number}) → #{OUTPUT_DIR}")
  end

  desc "build/release-App nach /Applications kopieren und neu starten"
  lane :install do
    source = File.join(OUTPUT_DIR, "#{APP_NAME}.app")
    target = "/Applications/#{APP_NAME}.app"
    UI.user_error!("#{source} fehlt – zuerst `fastlane mac archive`") unless File.directory?(source)

    sh("osascript", "-e", "quit app \"#{APP_NAME}\"", error_callback: ->(_) {})
    sleep(1)
    sh("rm", "-rf", target)
    sh("ditto", source, target)
    sh("open", target)
    UI.success("#{target} installiert und gestartet")
  end


  desc "Build-Nummer erhöhen, Release bauen und installieren"
  lane :release do |options|
    bump unless options[:bump] == false
    archive
    install unless options[:install] == false
  end

  desc "Release mit Developer-ID-Signatur nach build/developer-id exportieren"
  lane :developer_id do |options|
    generate
    # Die Website-/GitHub-Ausgabe enthält die Zusatzmodule (siehe Sources/Core/Edition.swift).
    conditions = options[:full] == false ? "" : "SWIFT_ACTIVE_COMPILATION_CONDITIONS=FULL_EDITION "
    # Direkt mit xcodebuild: build_mac_app exportiert macOS-Apps sonst mit der Development-Signatur.
    archive_path = File.join(ROOT, "build", "#{SCHEME}-DeveloperID.xcarchive")
    export_options = File.join(ROOT, "build", "ExportOptions-DeveloperID.plist")
    File.write(export_options, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>method</key><string>developer-id</string>
        <key>teamID</key><string>#{TEAM_ID}</string>
        <key>signingStyle</key><string>automatic</string>
      </dict></plist>
    PLIST
    sh("rm", "-rf", archive_path, DEVID_DIR)
    sh("set -o pipefail && xcodebuild -project #{PROJECT.shellescape} -scheme #{SCHEME} -configuration Release " \
       "-destination generic/platform=macOS -derivedDataPath #{DERIVED.shellescape} " \
       "-archivePath #{archive_path.shellescape} -allowProvisioningUpdates #{conditions}clean archive | xcpretty")
    sh("xcodebuild", "-exportArchive", "-archivePath", archive_path, "-exportOptionsPlist", export_options,
       "-exportPath", DEVID_DIR, "-allowProvisioningUpdates")

    app = File.join(DEVID_DIR, "#{APP_NAME}.app")
    sh("codesign", "--verify", "--deep", "--strict", "--verbose=2", app)
    authority = `codesign -dvv #{app.shellescape} 2>&1`[/Authority=(.+)/, 1]
    UI.user_error!("Falsch signiert: #{authority}") unless authority.to_s.start_with?("Developer ID Application")
    UI.message("Signiert mit: #{authority}")
    UI.success("#{APP_NAME} #{marketing_version} (#{build_number}) mit Developer ID → #{DEVID_DIR}")
  end

  desc "App notarisieren und Ticket anheften"
  lane :notarize_app do
    app = File.join(DEVID_DIR, "#{APP_NAME}.app")
    UI.user_error!("#{app} fehlt – zuerst `fastlane mac developer_id`") unless File.directory?(app)
    zip = File.join(DEVID_DIR, "#{APP_NAME}-notarize.zip")
    sh("ditto", "-c", "-k", "--keepParent", app, zip)
    notarize_and_staple(zip)
    File.delete(zip)
    sh("xcrun", "stapler", "staple", app)
    sh("spctl", "--assess", "--type", "execute", "--verbose", app)
  end

  desc "Signiertes, notarisiertes DMG nach build/dist bauen"
  lane :dmg do
    app = File.join(DEVID_DIR, "#{APP_NAME}.app")
    UI.user_error!("#{app} fehlt – zuerst `fastlane mac developer_id`") unless File.directory?(app)
    staging = File.join(ROOT, "build", "dmg-staging")
    sh("rm", "-rf", staging)
    FileUtils.mkdir_p([staging, DIST_DIR])
    sh("ditto", app, File.join(staging, "#{APP_NAME}.app"))
    File.symlink("/Applications", File.join(staging, "Programme"))

    dmg = File.join(DIST_DIR, "Crohniq-Dock-#{marketing_version}-#{build_number}.dmg")
    sh("hdiutil", "create", "-volname", APP_NAME, "-srcfolder", staging, "-ov", "-format", "UDZO", dmg)
    sh("rm", "-rf", staging)
    # Das Developer-ID-Zertifikat verwaltet Xcode in der Cloud; liegt es auch lokal vor, wird das DMG zusätzlich signiert.
    if (identity = developer_id_identity)
      sh("codesign", "--sign", identity, "--timestamp", dmg)
    else
      UI.message("Kein lokales Developer-ID-Zertifikat – DMG wird unsigniert notarisiert (die App darin ist signiert).")
    end
    notarize_and_staple(dmg)
    sh("xcrun", "stapler", "staple", dmg)
    sh("xcrun", "stapler", "validate", dmg)
    FileUtils.cp(dmg, DMG_LATEST)
    UI.success("Fertig zum Verteilen: #{dmg}")
  end

  desc "DMG als GitHub-Release veröffentlichen (Tag v<Version>-<Build>)"
  lane :github_release do
    UI.user_error!("#{DMG_LATEST} fehlt – zuerst `fastlane mac dmg`") unless File.exist?(DMG_LATEST)
    tag = "v#{marketing_version}-#{build_number}"
    notes = <<~NOTES
      **Crohniq Dock #{marketing_version} (Build #{build_number})** – volle Ausgabe mit allen Zusatzmodulen:
      letzte WhatsApp- und Signal-Chats sowie Safari- und Firefox-Verlauf in den aufklappenden Listen.

      Download: **Crohniq-Dock.dmg** öffnen und die App in „Programme“ ziehen. Signiert und von Apple notarisiert.
      Die Zusatzmodule brauchen „Festplattenvollzugriff“ – der Freigaben-Assistent in den Einstellungen führt dich hin.

      ---
      Full edition with all add-ons: recent WhatsApp and Signal chats plus Safari and Firefox history.
      Open **Crohniq-Dock.dmg** and drag the app to Applications. Signed and notarized by Apple.
    NOTES
    sh("gh", "release", "create", tag, DMG_LATEST, "--repo", GITHUB_REPO, "--target", "main",
       "--title", "Crohniq Dock #{marketing_version} (#{build_number})", "--notes", notes, "--latest")
    UI.success("https://github.com/#{GITHUB_REPO}/releases/latest/download/Crohniq-Dock.dmg")
  end

  desc "Texte und Screenshots aus fastlane/metadata und fastlane/screenshots nach App Store Connect hochladen"
  # Option screenshots_only:true lädt nur die Bilder. Voraussetzung für den Text-Upload: In App Store Connect
  # sind unter „Informationen zur App-Prüfung“ einmal die Kontaktdaten eingetragen (sonst bricht deliver ab).
  lane :upload_metadata do |options|
    deliver(
      api_key: asc_api_key,
      platform: "osx",
      app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
      app_version: marketing_version,
      metadata_path: File.join(ROOT, "fastlane", "metadata"),
      screenshots_path: File.join(ROOT, "fastlane", "screenshots"),
      skip_binary_upload: true,
      skip_metadata: options[:screenshots_only] == true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Build-Nummer erhöhen, mit Developer ID bauen, notarisieren und DMG erstellen"
  lane :distribute do |options|
    bump unless options[:bump] == false
    developer_id
    notarize_app
    dmg
    github_release if options[:publish] == true
  end
end
